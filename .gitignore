# macOS
.DS_Store

# Editor noise
*~
*.swp
.vscode/
.idea/

# Local archive of prior dataset snapshots -- now superseded by git history
archive/
99-archive/
crops_data_final.scratch.json

# Personal local permission overrides (machine-specific allow/ask/deny -- not team policy)
.claude/settings.local.json

# Review artifacts (generated, not dataset content)
CROP_REVIEW_*.html
CROP_REVIEW_*.doc

# Session handoff staging (gitignored -- durable for a fresh chat, not committed)
_handoff/

# Fetched-document cache for tools/doc_mentions_crop_scan.py (regenerable, now 28MB / 1,216 docs).
# NO TRAILING SLASH, deliberately: a trailing slash matches a DIRECTORY only, so a fresh worktree
# that links the real cache in as a SYMLINK had the link show up UNTRACKED and committable, absolute
# path and all (found 2026-09-21, PLA-580). Without the slash the pattern matches the directory, the
# symlink or a file at that exact path. MEASURED before changing, per Trevor's condition: put to
# `git check-ignore` against 1,780 tracked paths plus 13 adversarial near-misses (.doc_cache_backup,
# .doc_cache2, .doc_cachex/y, doc_cache, .doc_cache.json, a/tools/.doc_cache, ...), the change newly
# ignores EXACTLY ONE path -- tools/.doc_cache itself -- and nothing stops being ignored.
tools/.doc_cache

# Audit / comparison snapshots of the canonical (24MB each -- never commit these).
# The canonical is crops_data_final.json; every prior state is recoverable from git
# history, and tools/promote_fixture.py rebuilds any pinned SHA exactly.
crops_data_final.*.json

# Per-crop export for external blind audits (generated, never committed)
audit_export/

# PLA-8 batch staging: derivable copies, never committed (batch 24 convention).
# scratch canonicals are 27MB and reproducible from the promote; control_methods and
# shipped_precedents are extracts of canonical itself.
tools/staging/*/scratch_*.json
tools/staging/*/control_methods.json
tools/staging/*/shipped_precedents.json
