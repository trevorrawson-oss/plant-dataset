<tr><td class='crop'>bok-choy <span class="tag new">new</span></td><td>&larr; broccoli</td><td class='pass'>PASS</td><td>13</td><td>3</td></tr>
<tr><td class='crop'>parsnip <span class="tag new">new</span></td><td>&larr; carrot</td><td class='pass'>PASS</td><td>9</td><td>6</td></tr>
