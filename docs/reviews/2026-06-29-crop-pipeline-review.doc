<tr><td class='crop'>butternut-squash <span class="tag">batch 1</span></td><td>&larr; zucchini-courgette</td><td class='pass'>PASS</td><td>17</td><td>5</td></tr>
<tr><td class='crop'>garlic <span class="tag new">new</span></td><td>&larr; onion</td><td class='pass'>PASS</td><td>11</td><td>9</td></tr>
