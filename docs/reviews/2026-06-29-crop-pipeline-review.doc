<tr><td class='crop'>cucumber <span class="tag new">new</span></td><td>&larr; zucchini-courgette</td><td class='pass'>PASS</td><td>11</td><td>4</td></tr>
<tr><td class='crop'>collards <span class="tag new">new</span></td><td>&larr; broccoli</td><td class='pass'>PASS</td><td>27</td><td>5</td></tr>
